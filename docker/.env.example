# 前端/Subconverter 对外地址。反向代理部署时填写真实域名。
PUBLIC_PROTO=http
PUBLIC_HOST=localhost:18080

# 短链对外地址。默认与前端同源；独立域名部署示例：
# SHORT_PROTO=https
# SHORT_HOST=s.example.com
SHORT_PROTO=http
SHORT_HOST=localhost:18080

HTTP_PORT=18080
SITE_NAME=kortin's 订阅转换

# 建议固定为明确的镜像版本或 digest，避免 latest 漂移
SUBCONVERTER_IMAGE=metacubex/subconverter:latest
MYURLS_IMAGE=stilleshan/myurls:2024-05-02
REDIS_IMAGE=redis:7.4-alpine
